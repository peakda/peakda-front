# 이 파일은 커밋된다 — 실제 값은 넣지 않는다. 실제 값은 Vercel 프로젝트 환경변수에 둔다.

# Sentry 알림 메일 → Discord 중계 (src/app/api/sentry-email-to-discord, docs/SENTRY_DISCORD_ALERTS.md)
# 서버에서만 읽는다. NEXT_PUBLIC_ 접두어를 붙이면 클라이언트 번들에 노출되니 붙이지 않는다.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/<id>/<token>
# Apps Script 의 BRIDGE_SECRET 과 같은 값. 예: openssl rand -hex 32
SENTRY_ALERT_BRIDGE_SECRET=

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# swagger spec (generated by fetch-swagger.mjs)
/swagger.json

# orval 임시 출력 (sync-generated.mjs 가 정리)
/src/api/facades/.generated-next

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
